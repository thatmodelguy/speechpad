<Window x:Class="SpeechPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speech Pad"
        Icon="Assets/AppIcon.ico"
        Width="440"
        Height="560"
        MinWidth="340"
        MinHeight="400"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FF14171C"
        Foreground="#FFE8EAED">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowSheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF1C2128" Offset="0" />
            <GradientStop Color="#FF12151A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MicIdleBrush" StartPoint="0.3,0" EndPoint="0.7,1">
            <GradientStop Color="#FF5B9DFF" Offset="0" />
            <GradientStop Color="#FF2A62D6" Offset="0.45" />
            <GradientStop Color="#FF1A3F9A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MicListenBrush" StartPoint="0.3,0" EndPoint="0.7,1">
            <GradientStop Color="#FFFF6B5C" Offset="0" />
            <GradientStop Color="#FFD93A2B" Offset="0.45" />
            <GradientStop Color="#FF9B1F16" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A62D6" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF8A9099" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="Transparent" />
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"
                                                      Fill="#FFB0B6BF" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="10,8,32,8"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FF1A1F27"
                                            BorderBrush="#FF3A414C"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12"
                                                              ShadowDepth="4"
                                                              Direction="270"
                                                              Color="#FF000000"
                                                              Opacity="0.55" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF8A9099" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RaisedChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="#FF3A414C"
                                Background="#FF222831"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="3"
                                                  Direction="270"
                                                  Color="#FF000000"
                                                  Opacity="0.55" />
                            </Border.Effect>
                            <Border CornerRadius="9"
                                    BorderThickness="1"
                                    BorderBrush="#55FFFFFF"
                                    Margin="1"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF2C3340" Offset="0" />
                                        <GradientStop Color="#FF1A1F27" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#FF5A6575" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#FF181C22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowSheen}" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Microphone picker -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mic"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Opacity="0.7"
                           FontSize="12" />

                <Border Grid.Column="1"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="#FF2A3038"
                        Background="#FF0E1116">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          ShadowDepth="2"
                                          Direction="90"
                                          Color="#FF000000"
                                          Opacity="0.65" />
                    </Border.Effect>
                    <ComboBox x:Name="MicrophoneCombo"
                              Style="{StaticResource DarkComboBox}"
                              SelectionChanged="MicrophoneCombo_SelectionChanged" />
                </Border>
            </Grid>

            <!-- Recessed notes well -->
            <Border Grid.Row="1"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="#FF0A0C10"
                    Background="#FF0B0E13"
                    Padding="3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="4"
                                      Direction="90"
                                      Color="#FF000000"
                                      Opacity="0.7" />
                </Border.Effect>
                <Border CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#FF2A313C"
                        Background="#FF171B22">
                    <TextBox x:Name="NotesTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"
                             Padding="12"
                             Foreground="#FFE8EAED"
                             CaretBrush="#FF8EB6FF"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Top" />
                </Border>
            </Border>

            <!-- Controls -->
            <Grid Grid.Row="2" Margin="0,18,0,8" MinHeight="88">
                <Button x:Name="ClearButton"
                        Style="{StaticResource RaisedChipButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        MinWidth="92"
                        Click="ClearButton_Click"
                        Content="Clear"
                        ToolTip="Clear notes" />

                <Button x:Name="DictateButton"
                        Width="78"
                        Height="78"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="DictateButton_Click"
                        Cursor="Hand"
                        ToolTip="Start or stop dictation">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="#66000000" Margin="4,8,4,0" />
                                <Ellipse x:Name="Bg"
                                         Fill="{StaticResource MicIdleBrush}"
                                         StrokeThickness="1.5"
                                         Stroke="#66FFFFFF">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="16"
                                                          ShadowDepth="6"
                                                          Direction="270"
                                                          Color="#FF000000"
                                                          Opacity="0.65" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="54"
                                         Height="28"
                                         VerticalAlignment="Top"
                                         Margin="0,10,0,0"
                                         Opacity="0.35">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="MicIcon"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE720;"
                               FontSize="30"
                               Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Color="#FF000000"
                                              Opacity="0.5" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>

                <Button x:Name="CopyButton"
                        Style="{StaticResource RaisedChipButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="92"
                        Click="CopyButton_Click"
                        Content="Copy"
                        ToolTip="Copy notes to clipboard" />
            </Grid>

            <StackPanel Grid.Row="3">
                <CheckBox x:Name="AutoCopyCheckBox"
                          Content="Auto-copy when stopped"
                          Margin="0,0,0,8"
                          Opacity="0.85"
                          FontSize="12"
                          Foreground="#FFE8EAED"
                          Checked="AutoCopyCheckBox_Changed"
                          Unchecked="AutoCopyCheckBox_Changed"
                          ToolTip="Automatically copy notes to the clipboard when you stop dictation" />

                <TextBlock x:Name="StatusText"
                           Text="Ready — click the microphone to dictate"
                           Opacity="0.55"
                           TextWrapping="Wrap"
                           FontSize="12" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
